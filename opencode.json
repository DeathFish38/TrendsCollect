{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "model": "scx/coder",
  "small_model": "scx/coder",
  "agent": {
    "plan":  { "mode": "primary", "model": "scx/Qwen3.8-Max" },
    "build": { "mode": "primary", "model": "scx/Kimi-K3.1-Pro" }
  },
  "provider": {
    "scx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SCX.ai",
      "options": {
        "baseURL": "https://api.scx.ai/v1",
        "apiKey": "{env:SCX_API_KEY}"
      },
      "models": {
        "Qwen3.8-Max": {
          "name": "Qwen3.8-Max",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 191000, "output": 8000 }
        },
        "Kimi-K3.1-Pro": {
          "name": "Kimi-K3.1-Pro",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 191000, "output": 8000 }
        }
      }
    }
  }
}
